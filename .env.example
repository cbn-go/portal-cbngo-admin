APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco MySQL compartilhado com o portal público (cbn-go/portal-cbngo-site).
# O painel é o dono do schema: só ele executa `php artisan migrate`.
# O portal público conecta no mesmo banco com um usuário somente leitura, por exemplo:
#   CREATE USER 'cbngo_site'@'%' IDENTIFIED BY '...';
#   GRANT SELECT ON cbngo.* TO 'cbngo_site'@'%';
# Mapeamento de campos: docs/integracao-portal-publico.md
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cbngo
DB_USERNAME=cbngo_admin
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mídia compartilhada com o portal público (uploads do painel).
# Vazios, usam storage/app/public e APP_URL/storage (desenvolvimento).
# Produção (Hostinger):
#   MEDIA_ROOT=/home/<usuario>/domains/midia.cbngo.org.br/public_html
#   MEDIA_URL=https://midia.cbngo.org.br
MEDIA_ROOT=
MEDIA_URL=
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
